# ── App ──────────────────────────────────────────────
APP_NAME="Red Rose Laundry API"
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/redrose_db

# ── M-Pesa Daraja (Safaricom) ─────────────────────────
# Get from https://developer.safaricom.co.ke
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379       # Your Paybill or Till Number (174379 = sandbox default)
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/mpesa/callback

# Sandbox base URL: https://sandbox.safaricom.co.ke
# Production URL:   https://api.safaricom.co.ke
